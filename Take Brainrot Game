});

// Auto save / load (simple)
function saveState(){ localStorage.setItem('takeabr_enhanced', JSON.stringify({player:state.player, spawnRate: state.spawnRate, adminUnlocked: state.adminUnlocked})); }
function loadState(){ const s = localStorage.getItem('takeabr_enhanced'); if(s){ const obj = JSON.parse(s); state.player = Object.assign(state.player, obj.player||{}); state.spawnRate = obj.spawnRate || state.spawnRate; state.adminUnlocked = obj.adminUnlocked || state.adminUnlocked; if(state.adminUnlocked) $('adminControls').style.display = 'block'; } }
setInterval(saveState, 6000);
loadState();

