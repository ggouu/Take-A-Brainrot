/////////////////////// SHOP ///////////////////////
const SHOP = [
  {id:'pack_small', name:'Small Robo Pack', price:300, effect:pl => pl.money += 300},
  {id:'pack_med', name:'Med Robo Pack', price:1800, effect:pl => pl.money += 1800},
  {id:'bag_upgrade', name:'Bag Upgrade', price:5200, effect:pl => {/* future hook */}}
];
function renderShop(){
  const cont = $('shopItems'); cont.innerHTML = '';
  for(const it of SHOP){
    const div = document.createElement('div'); div.style.display='flex'; div.style.justifyContent='space-between'; div.style.alignItems='center'; div.style.marginBottom='8px';
    div.innerHTML = `<div><strong>${it.name}</strong><div class="tiny muted">Price: ${it.price} Robo</div></div><div><button class="btn buyBtn">Buy</button></div>`;
    div.querySelector('.buyBtn').onclick = ()=>{
      if(state.player.money >= it.price){ state.player.money -= it.price; it.effect(state.player); updateUI(); showTemp('Purchased ' + it.name); } else showTemp('Not enough Robo');
    };
    cont.appendChild(div);
  }
}

/////////////////////// UI Updates ///////////////////////
function updateUI(){
  $('moneyDisplay').innerText = state.player.money.toLocaleString();
  $('invCount').innerText = state.player.inventory.length;
  $('playerLevel').innerText = state.player.level;
}

function showTemp(msg, dur=1200){
  const p = document.createElement('div'); p.className='popup'; p.innerText = msg;
  document.body.appendChild(p);
  setTimeout(()=> p.remove(), dur);
}

/////////////////////// Control Loop (player movement etc) ///////////////////////
function controlLoop(){
  const speed = 220;
  const dt = 16; // simulated step
  if(keys['w']||keys['arrowup']) state.player.y -= speed*(dt/16);
  if(keys['s']||keys['arrowdown']) state.player.y += speed*(dt/16);
  if(keys['a']||keys['arrowleft']) state.player.x -= speed*(dt/16);
  if(keys['d']||keys['arrowright']) state.player.x += speed*(dt/16);
  // clamp to borders
  state.player.x = clamp(state.player.x, borders.left, borders.right);
  state.player.y = clamp(state.player.y, borders.top, borders.bottom);
  // check interaction keys
  if(keys['f']){ tryPickupNearest(); keys['f'] = false; }
  if(keys['e']){ tryDeliverToBase(); keys['e'] = false; }
  requestAnimationFrame(controlLoop);
}

/////////////////////// INIT / START ///////////////////////
let running = false;
function startGame(){
  // unlock audio (some browsers require user gesture)
  try{ audioCtx.resume(); }catch(e){}
  // initial seed
  for(let i=0;i<6;i++) spawnBrainrot();
  renderShop();
  updateUI();
  initCanvasSize();
  lastT = performance.now();
  running = true;
  requestAnimationFrame(gameLoop);
  requestAnimationFrame(controlLoop);
  // start background spawn timer
  state.lastSpawn = now();
  // hide intro overlay with a nice transition
  const intro = $('introOverlay');
  intro.style.transition = 'opacity .6s var(--easing), transform .6s var(--easing)';
  intro.style.opacity = 0; intro.style.transform = 'scale(0.98)';
  setTimeout(()=> intro.style.display = 'none', 620);
  // cosmetic sound + flourish
  beep(520,0.12,0.05,'sawtooth');
  spawnFlash(state.player.x, state.player.y, '#9af7ff');
  updateUI();
}

// demo quick start
$('startBtn').onclick = startGame;
$('demoBtn').onclick = ()=> { startGame(); showTemp('Demo mode — enjoy!'); };

