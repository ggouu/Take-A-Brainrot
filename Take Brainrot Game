<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Take A Brainrot — Enhanced</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<style>
  /* ---------- THEME & LAYOUT ---------- */
  :root{
    --bg-top:#071427; --bg-bottom:#07101b;
    --glass: rgba(255,255,255,0.04);
    --accent:#7af7d2;
    --ui-accent: #6fd7ff;
    --soft: 14px;
    --easing: cubic-bezier(.16,.9,.24,1);
  }
  *{box-sizing:border-box;font-family:Inter,Segoe UI,system-ui,Arial,sans-serif}
  html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg-top),var(--bg-bottom));color:#eaf6ff;overflow:hidden}
  #app{height:100vh;display:flex;flex-direction:column}
  header{height:68px;display:flex;align-items:center;justify-content:space-between;padding:12px 20px;backdrop-filter:blur(6px);background:linear-gradient(90deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));box-shadow:0 6px 30px rgba(0,0,0,0.45)}
  header h1{font-size:18px;letter-spacing:0.6px;margin:0}
  .top-controls{display:flex;gap:10px;align-items:center}
  .btn{background:linear-gradient(180deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));border:1px solid rgba(255,255,255,0.06);padding:8px 12px;border-radius:10px;color:#fff;cursor:pointer;font-weight:600;transition:transform .15s var(--easing), box-shadow .15s var(--easing)}
  .btn:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(15,25,40,0.45)}
  .main{display:flex;gap:16px;padding:14px;height:calc(100vh - 92px)}
  #left{flex:1;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(0,0,0,0.12));padding:12px;position:relative;overflow:hidden}
  #right{width:380px;display:flex;flex-direction:column;gap:12px}
  canvas{display:block;width:100%;height:100%;border-radius:8px;background:linear-gradient(180deg,#07101a,#04101a)}
  .panel{background:var(--glass);padding:12px;border-radius:10px;backdrop-filter: blur(4px);box-shadow:0 8px 24px rgba(0,0,0,0.45)}
  .small{font-size:13px;color:#dff7f0}
  .muted{opacity:0.85;font-size:12px}
  /* ---------- INTRO ANIMATIONS ---------- */
  #introOverlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:80;pointer-events:auto}
  .logoWrap{display:flex;align-items:center;gap:12px;transform:translateY(-24px);opacity:0;animation:logoIn .9s .15s both}
  @keyframes logoIn{to{transform:none;opacity:1}}
  .logo{width:110px;height:110px;border-radius:14px;background:linear-gradient(135deg,#ffb84d,#ff6a00);display:flex;align-items:center;justify-content:center;font-weight:900;color:#111;font-size:22px;box-shadow:0 14px 40px rgba(255,120,20,0.12), inset 0 -6px 18px rgba(0,0,0,0.12)}
  .tag{font-size:14px;opacity:0.95}
  .introCard{margin-top:18px;padding:18px 24px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(0,0,0,0.08));transform:translateY(14px);opacity:0;animation:cardIn .9s .3s both}
  @keyframes cardIn{to{transform:none;opacity:1}}
  .startPulse{display:inline-block;padding:10px 16px;border-radius:12px;margin-top:12px;background:linear-gradient(90deg,var(--ui-accent),#9bffdf);color:#052; font-weight:800; box-shadow:0 12px 30px rgba(107,230,220,0.12); animation:pulse 1.6s infinite;}
  @keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.06)}100%{transform:scale(1)}}
  /* ---------- SPAWN PARTICLES & EFFECTS ---------- */
  .fx-canvas{position:absolute;inset:0;pointer-events:none;z-index:30}
  .hudTop{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .statPill{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(0,0,0,0.06));padding:8px 10px;border-radius:10px;display:flex;gap:10px;align-items:center}
  .rarityGlow{filter:drop-shadow(0 0 12px rgba(0,0,0,0.6))}
  /* ---------- POPUP / ACHIEVEMENT ---------- */
  .popup{position:fixed;right:20px;bottom:20px;background:linear-gradient(180deg,#0f1720,#07101a);padding:12px;border-radius:12px;color:#fff;z-index:120;box-shadow:0 18px 48px rgba(0,0,0,0.6);transform:translateY(10px);opacity:0;animation:popupIn .45s both}
  @keyframes popupIn{to{transform:none;opacity:1}}
  /* ---------- SHOP PANEL ANIMATION ---------- */
  .slideIn{transform:translateX(120%);opacity:0;transition:transform .45s var(--easing),opacity .45s var(--easing)}
  .slideShow{transform:none;opacity:1}
  /* ---------- SMALL UTILS ---------- */
  .tiny{font-size:12px;opacity:0.9}
  .glow{box-shadow:0 0 16px rgba(255,255,255,0.04), 0 8px 30px rgba(0,0,0,0.5)}
  /* responsive */
  @media(max-width:980px){ #right{display:none} .main{padding:8px} }
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>Take A Brainrot — Enhanced</h1>
    <div class="top-controls">
      <div class="statPill"><div class="small">Robo</div><div id="moneyDisplay" style="font-weight:800;margin-left:6px">0</div></div>
