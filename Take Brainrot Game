<!-- ---------- SINGLE-FILE GAME LOGIC (JS) ---------- -->
<script>
/* Enhanced Take A Brainrot — single file prototype
   - Animated intro and transitions
   - Particle spawn & pickup effects
   - Rarity glows + visual polish
   - Shop, private UI, rebirth, admin
   - Bots simulate other players
   Save as take_a_brainrot_enhanced.html and open in Chrome.
*/

/////////////////////// Utilities ///////////////////////
const $ = id => document.getElementById(id);
function rand(a,b){ return Math.random()*(b-a)+a; }
function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
function dist(a,b,c,d){ return Math.hypot(c-a, d-b); }
function now(){ return performance.now(); }

// lightweight sound FX via WebAudio
const audioCtx = new (window.AudioContext||window.webkitAudioContext)();
function beep(freq=440, time=0.06, vol=0.06, type='sine'){
  try{
    const o=audioCtx.createOscillator();
    const g=audioCtx.createGain();
    o.type=type; o.frequency.value=freq; g.gain.value=vol;
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime + time);
  }catch(e){}
}

/////////////////////// Canvas + FX ///////////////////////
const canvas = $('gameCanvas');
const fxCanvas = $('fxCanvas');
const ctx = canvas.getContext('2d');
const fx = fxCanvas.getContext('2d');

function resizeCanvases(){
  const rect = canvas.getBoundingClientRect();
  canvas.width = rect.width * devicePixelRatio;
  canvas.height = rect.height * devicePixelRatio;
  canvas.style.width = rect.width + 'px';
  canvas.style.height = rect.height + 'px';
  fxCanvas.width = canvas.width;
  fxCanvas.height = canvas.height;
  fxCanvas.style.width = rect.width + 'px';
  fxCanvas.style.height = rect.height + 'px';
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
  fx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
}
window.addEventListener('resize', () => { resizeCanvases(); });

/* world size (logical coords) */
let W = 1200, H = 700;
function initCanvasSize(){ resizeCanvases(); }
initCanvasSize();

/////////////////////// Game Config ///////////////////////
const CONFIG = {
  spawnInterval: 1800,
  botCount: 3,
  invisiblePad: 8,
  adminCost: 10_000_000,
  maxBrainrots: 140
};

/////////////////////// Rarities ///////////////////////
const RARITIES = [
  {id:'common', name:'Common', color:'#3ddc84', glow:'rgba(61,220,132,0.18)', weight:0.56, mult:1},
  {id:'rare',   name:'Rare',   color:'#2b8af6', glow:'rgba(43,138,246,0.22)', weight:0.24, mult:2},
  {id:'legendary',name:'Legendary',color:'#ffd24a', glow:'rgba(255,210,74,0.25)', weight:0.12, mult:4},
  {id:'mythic', name:'Mythic', color:'#ff4b4b', glow:'rgba(255,75,75,0.28)', weight:0.06, mult:8},
  {id:'secret', name:'Secret', color:'#000000', glow:'rgba(255,255,255,0.85)', weight:0.014, mult:16},
  {id:'BEST', name:'BEST', color:'#ff9a1f', glow:'rgba(255,150,40,0.34)', weight:0.006, mult:64}
];
function pickRarity(){
  let r = Math.random();
  for(const k of RARITIES){
    if(r < k.weight) return k;
    r -= k.weight;
  }
  return RARITIES[0];
}

/////////////////////// World: track + black wall ///////////////////////
const track = { x: 330, y: 42, w: 540, h: 52, colors: ['#ff4b4b','#2b8af6','#3ddc84'] };
const blackWall = { x: 330, y: track.y + track.h + 6, w: track.w, h: 28 }; // origin strip
const borders = { left: CONFIG.invisiblePad, right: 1180 - CONFIG.invisiblePad, top: CONFIG.invisiblePad, bottom: 680 - CONFIG.invisiblePad };

/////////////////////// State ///////////////////////
const state = {
  player: { x:120, y:520, r:14, name:'You', inventory:[], money:0, rebirths:0, level:1 },
  bots: [],
  brainrots: [],
  bases: [],
  lastSpawn: 0,
  spawnRate: CONFIG.spawnInterval,
  adminUnlocked: false,
  privateMode: false,
  particles: []
};

/////////////////////// Bases & Bots ///////////////////////
function createBase(x,y,name){ return { x, y, w:140, h:90, name, stored:[] }; }
state.bases.push(createBase(30,70, state.player.name));
for(let i=0;i<CONFIG.botCount;i++) state.bases.push(createBase(980, 60 + i*140, 'Bot'+(i+1)));
for(let i=0;i<CONFIG.botCount;i++){
  state.bots.push({
    id:'bot'+i, x:980+rand(-12,12), y:120 + i*140, r:12, name:'Bot'+(i+1),
    inventory:[], vx: rand(-24,24), vy: rand(-18,18), speed: 40
  });
}

/////////////////////// Brainrot entity ///////////////////////
let brID = 1;
function spawnBrainrot(){
  if(state.brainrots.length > CONFIG.maxBrainrots) return;
  const rx = rand(track.x+8, track.x+track.w-8);
  const ry = blackWall.y + rand(2, blackWall.h-4);
  const rarity = pickRarity();
  const br = {
    id:'br'+(brID++),
    x: rx, y: ry,
    vx: rand(-0.18,0.18), vy: rand(-0.12,0.12),
    r: 10 + (rarity.mult > 4 ? 6 : 0),
    rarity,
    owner: null,
    birth: now(),
    wobble: rand(0,10000)
  };
  state.brainrots.push(br);
  spawnFlash(rx,ry,rarity.color);
  beep(900,0.05,0.03,'triangle');
}

/////////////////////// PARTICLES (fx) ///////////////////////
function spawnFlash(x,y,color){
  // small particle burst
  for(let i=0;i<18;i++){
    state.particles.push({
      x, y, vx: rand(-2.8,2.8), vy: rand(-2.2, -0.2), life: rand(600,1000),
      age:0, col: color, size: rand(1.8,4.6)
    });
  }
}
function spawnPickupPop(x,y,color){
  for(let i=0;i<10;i++){
    state.particles.push({
      x,y,vx:rand(-2.4,2.4),vy:rand(-4.2,-1.2),life:rand(600,1100),age:0,col:color,size:rand(2,5)
    });
  }
}
function updateParticles(dt){
  for(let i=state.particles.length-1;i>=0;i--){
    const p = state.particles[i];
    p.age += dt;
    p.x += p.vx * (dt/16); p.y += p.vy * (dt/16);
    p.vy += 0.06 * (dt/16);
    if(p.age >= p.life) state.particles.splice(i,1);
  }
}
function drawParticles(ctx){
  for(const p of state.particles){
    const a = 1 - (p.age / p.life);
    ctx.globalAlpha = a;
    ctx.fillStyle = p.col;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size * (a*1.2), 0, Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha = 1;
}

/////////////////////// DRAW WORLD ///////////////////////
function drawWorld(){
  // clear
  ctx.clearRect(0,0,canvas.width,canvas.height);

  // floor gradient
  const g = ctx.createLinearGradient(0,0,0,canvas.height);
  g.addColorStop(0,'#071424'); g.addColorStop(1,'#04101a');
  ctx.fillStyle = g; ctx.fillRect(0,0,canvas.width,canvas.height);

  // track stripes
  const stripeW = track.w/3;
  ctx.fillStyle = track.colors[0]; ctx.fillRect(track.x, track.y, stripeW, track.h);
  ctx.fillStyle = track.colors[1]; ctx.fillRect(track.x+stripeW, track.y, stripeW, track.h);
  ctx.fillStyle = track.colors[2]; ctx.fillRect(track.x+2*stripeW, track.y, stripeW, track.h);

  // black concrete wall
  ctx.fillStyle = '#0b0b0b'; ctx.fillRect(blackWall.x, blackWall.y, blackWall.w, blackWall.h);
  ctx.strokeStyle = '#1a1a1a'; ctx.lineWidth = 2; ctx.strokeRect(blackWall.x, blackWall.y, blackWall.w, blackWall.h);

  // bases
  for(const base of state.bases){
    ctx.fillStyle = 'rgba(255,255,255,0.03)'; ctx.fillRect(base.x, base.y, base.w, base.h);
    ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.strokeRect(base.x, base.y, base.w, base.h);
    ctx.fillStyle = '#fff'; ctx.font='bold 13px sans-serif'; ctx.fillText(base.name, base.x + 8, base.y - 8);
    ctx.fillStyle = '#bfe'; ctx.font='12px sans-serif'; ctx.fillText('Stored: '+base.stored.length, base.x + 8, base.y + base.h + 16);
  }

  // brainrots (behind players so they can be picked visually)
  for(const br of state.brainrots){
    const bob = Math.sin((now()/200) + br.wobble) * 3;
    const dx = br.x, dy = br.y + bob;
    const r = br.r;
    // glow
    ctx.save();
    if(br.rarity.glow){
      ctx.shadowColor = br.rarity.glow;
      ctx.shadowBlur = 20;
    }
    // shape
    if(br.rarity.id === 'secret'){
      ctx.fillStyle = '#000'; ctx.beginPath(); ctx.arc(dx,dy,r,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.fillRect(dx - r/2, dy - 2, r, 4);
    } else if(br.rarity.id === 'BEST'){
      // two-tone radial-ish
      const gg = ctx.createLinearGradient(dx-r,dy-r,dx+r,dy+r);
      gg.addColorStop(0,'#ffb84d'); gg.addColorStop(1,'#ff6a00'); ctx.fillStyle = gg;
      ctx.beginPath(); ctx.arc(dx,dy,r,0,Math.PI*2); ctx.fill();
    } else {
      ctx.fillStyle = br.rarity.color; ctx.beginPath(); ctx.arc(dx,dy,r,0,Math.PI*2); ctx.fill();
    }
    ctx.restore();
    // owner initial
    if(br.owner){
      ctx.fillStyle = '#fff'; ctx.font='11px sans-serif'; ctx.fillText(br.owner[0].toUpperCase(), dx - 6, dy - r - 8);
    }
  }

  // bots
  for(const b of state.bots){
    ctx.beginPath(); ctx.arc(b.x, b.y, b.r+2, 0, Math.PI*2);
    ctx.fillStyle = '#bfbfbf'; ctx.fill();
    ctx.fillStyle = '#000'; ctx.font='12px sans-serif'; ctx.fillText(b.name, b.x - 20, b.y - 18);
  }

  // player (front)
  ctx.beginPath(); ctx.arc(state.player.x, state.player.y, state.player.r+2, 0, Math.PI*2);
  ctx.fillStyle = '#8fe6ff'; ctx.fill();
  ctx.fillStyle = '#002'; ctx.font='bold 12px sans-serif'; ctx.fillText(state.player.name, state.player.x - 22, state.player.y - 20);
}

/////////////////////// PARTICLE FX DRAW ///////////////////////
function drawFX(dt){
  fx.clearRect(0,0,fxCanvas.width,fxCanvas.height);
  fx.save();
  // draw particles in high quality
  drawParticles(fx);
  fx.restore();
}

/////////////////////// GAME LOOP ///////////////////////
let lastT = performance.now();
function gameLoop(ts){
  const dt = ts - lastT; lastT = ts;
  // spawn logic
  if(now() - state.lastSpawn > state.spawnRate){
    spawnBrainrot();
    state.lastSpawn = now();
  }
  // move brainrots slightly
  for(const br of state.brainrots){
    br.x += br.vx * (dt/16) * 2;
    br.y += br.vy * (dt/16) * 2;
    // keep inside borders
    br.x = clamp(br.x, borders.left + 6, borders.right - 6);
    br.y = clamp(br.y, borders.top + 36, borders.bottom - 8);
  }
  // bots AI
  updateBots(dt);
  // update particles
  updateParticles(dt);
  // render
  drawWorld();
  drawFX(dt);
  requestAnimationFrame(gameLoop);
}

/////////////////////// INPUT ///////////////////////
const keys = {};
window.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; if(e.key === ' '){ e.preventDefault(); } });
window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });
canvas.addEventListener('click', e => {
  // try pick up nearest brainrot near click
  const rect = canvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left) * (canvas.width / rect.width) / devicePixelRatio;
  const my = (e.clientY - rect.top) * (canvas.height / rect.height) / devicePixelRatio;
  tryPickupAt(mx,my);
});

function tryPickupAt(x,y){
  // find nearest br within 44 px
  let nearest=null, nd=1e9;
  for(const br of state.brainrots){
    const d = dist(x,y,br.x,br.y);
    if(d < 44 && d < nd){ nd = d; nearest = br; }
  }
  if(nearest){
    state.player.inventory.push(nearest);
    const idx = state.brainrots.indexOf(nearest);
    if(idx !== -1) state.brainrots.splice(idx,1);
    spawnPickupPop(x,y, nearest.rarity.color);
    beep(1200,0.05,0.05,'sine');
    showTemp('Picked up ' + nearest.rarity.name, 1400);
    updateUI();
  }
}

function tryPickupNearest(){
  tryPickupAt(state.player.x, state.player.y);
}

function tryDeliverToBase(){
  const base = state.bases[0];
  const bx = base.x + base.w/2, by = base.y + base.h/2;
  if(dist(state.player.x, state.player.y, bx, by) < 58){
    // deliver all in inventory
    for(const br of state.player.inventory){
      base.stored.push(br);
      br.owner = state.player.name;
      const baseValue = 12 * br.rarity.mult;
      const rebBonus = 1 + state.player.rebirths * 0.06;
      const gained = Math.floor(baseValue * rebBonus);
      state.player.money += gained;
    }
    state.player.inventory = [];
    spawnPickupPop(bx,by,'#c8ffb6');
    showTemp('Delivered! Robo +' , 1600);
    beep(320,0.06,0.06,'square');
    updateUI();
  } else {
    showTemp('Get to your base to deliver!',1200);
  }
}

/////////////////////// Bots AI (steal/deliver) ///////////////////////
function updateBots(dt){
  for(const b of state.bots){
    if(b.inventory && b.inventory.length > 0){
      // go to own base
      const baseIndex = state.bots.indexOf(b) + 1;
      const base = state.bases[baseIndex];
      moveTowards(b, base.x + base.w/2, base.y + base.h/2, b.speed * (dt/16));
      // deliver
      if(dist(b.x,b.y, base.x + base.w/2, base.y + base.h/2) < 20){
        for(const br of b.inventory){ base.stored.push(br); br.owner = b.name; }
        b.inventory = [];
      }
    } else {
      // find nearest br
      const target = findNearestBrainrot(b.x, b.y, 340);
      if(target){
        moveTowards(b, target.x, target.y, b.speed * (dt/16));
        if(dist(b.x,b.y,target.x,target.y) < target.r + 8){
          b.inventory.push(target);
          const idx = state.brainrots.indexOf(target); if(idx !== -1) state.brainrots.splice(idx,1);
          spawnPickupPop(b.x, b.y, target.rarity.color);
        }
      } else {
        // wander
        b.x += b.vx * (dt/16);
        b.y += b.vy * (dt/16);
        if(Math.random() < 0.006){ b.vx = rand(-36,36); b.vy = rand(-28,28); }
        // boundary
        b.x = clamp(b.x, borders.left + 8, borders.right - 8);
        b.y = clamp(b.y, borders.top + 42, borders.bottom - 8);
      }
    }
    // possible steal chance if overlapping with player
    if(b.inventory && b.inventory.length > 0 && dist(b.x,b.y,state.player.x,state.player.y) < 34){
      // player steals with a probability
      if(Math.random() < 0.48){
        const stolen = b.inventory.pop();
        state.player.inventory.push(stolen);
        showTemp('Stole ' + stolen.rarity.name + ' from ' + b.name, 1400);
        spawnPickupPop(state.player.x, state.player.y, stolen.rarity.color);
        beep(1600,0.04,0.05,'sine');
      } else {
        // failed
        b.x += rand(-26,26); b.y += rand(-26,26);
      }
    }
  }
}

/////////////////////// Movement helpers ///////////////////////
function moveTowards(o, tx, ty, speed){
  const dx = tx - o.x, dy = ty - o.y;
  const d = Math.hypot(dx,dy);
  if(d < 1) return;
  o.x += (dx/d) * speed;
  o.y += (dy/d) * speed;
}

function findNearestBrainrot(x,y,maxD){
  let best=null, bd=maxD;
  for(const br of state.brainrots){
    const d = dist(x,y,br.x,br.y);
    if(d < bd){ bd = d; best = br; }
  }
  return best;
}

