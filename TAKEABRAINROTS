<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Take A Brainrot — Playable Prototype</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<style>
  :root{--bg1:#0b1020;--panel:rgba(255,255,255,0.04);--accent:#6ee7b7}
  *{box-sizing:border-box;font-family:Inter,system-ui,Arial,sans-serif}
  body,html{height:100%;margin:0;background:linear-gradient(180deg,#081226,#0b1530);color:#e8f0ff}
  #app{height:100vh;display:flex;flex-direction:column}
  header{padding:12px 18px;background:linear-gradient(90deg,#082233,#002b3a);display:flex;align-items:center;justify-content:space-between}
  .top-controls{display:flex;gap:8px;align-items:center}
  .btn{padding:8px 10px;border-radius:8px;background:#ffffff15;border:1px solid #ffffff10;color:#fff;cursor:pointer}
  .main{flex:1;display:flex;gap:12px;padding:12px}
  #left{width:920px;background:linear-gradient(180deg,#07101b,#071422);border-radius:10px;padding:10px;position:relative}
  #right{width:360px;display:flex;flex-direction:column;gap:10px}
  canvas{background:#0d1116;border-radius:8px;display:block}
  .panel{background:var(--panel);padding:10px;border-radius:8px}
  .small{font-size:12px;color:#cfeff1}
  #introOverlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0.7),rgba(0,0,0,0.6));display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:50}
  .smallBtn{padding:6px 8px;border-radius:6px;background:#ffffff10;border:1px solid #ffffff15;color:#fff;cursor:pointer}
  .popup{position:fixed;right:18px;bottom:18px;background:#06111a;padding:10px;border-radius:8px;border:1px solid #ffffff11}
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>Take A Brainrot</h1>
    <div class="top-controls">
      <div id="moneyDisplay" class="small">Robo: 0</div>
      <button class="btn" id="btnShop">Shop</button>
      <button class="btn" id="btnRebirth">Rebirth</button>
      <button class="btn" id="btnPrivate">Private Server</button>
    </div>
  </header>

  <div class="main">
    <div id="left">
      <div id="hud" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <div class="small">Player: <strong id="playerName">You</strong></div>
        <div class="small">Level: <span id="playerLevel">1</span></div>
        <div class="small">Inventory: <span id="invCount">0</span></div>
      </div>

      <canvas id="game" width="900" height="560"></canvas>

      <div id="introOverlay" style="display:flex;flex-direction:column">
        <h2 style="font-size:28px;margin:6px">Take A Brainrot</h2>
        <div class="small" style="max-width:540px;text-align:center;margin-bottom:12px">Steal, collect, and protect Brainrots! Use Robo currency to buy shop items and rebirth for bonuses.</div>
        <div style="display:flex;gap:8px">
          <button class="smallBtn" id="startBtn">Start Game</button>
          <button class="smallBtn" id="tutorialBtn">Quick Tutorial</button>
        </div>
      </div>
    </div>

    <div id="right">
      <div class="panel">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <strong>Shop</strong><div class="small">Use Robo</div>
        </div>
        <div id="shop-items" style="margin-top:8px"></div>
      </div>

      <div class="panel">
        <strong>Rebirth</strong>
        <div class="small">Rebirth resets level in exchange for a permanent multiplier.</div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <button class="btn" id="rebirthBtn">Rebirth (cost: 1,000,000 Robo)</button>
          <div class="small" id="rebirthCount">Rebirths: 0</div>
        </div>
      </div>

      <div class="panel">
        <strong>Private Server</strong>
        <div id="privateServerUI" style="margin-top:8px">
          <div class="small">Mode: <span id="psMode">Public</span></div>
          <button class="btn" id="makePrivateBtn">Make Private (UI only)</button>
        </div>
      </div>

      <div class="panel">
        <strong>Admin Panel</strong>
        <div class="small">Cost: 10,000,000 Robo</div>
        <button class="btn" id="buyAdminBtn">Purchase Admin</button>
        <div id="adminPanel" style="margin-top:8px;display:none">
          <div class="small">Admin unlocked — modify spawn rate</div>
          <div style="display:flex;gap:6px;margin-top:6px">
            <button class="btn" id="adminSpawnFaster">Spawn Faster</button>
            <button class="btn" id="adminSpawnSlower">Spawn Slower</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div style="padding:10px" class="small">
    <strong>Note:</strong> Brainrot visuals are original placeholders. Bots simulate other players for this demo.
  </div>
</div>

<script>
/* Playable prototype script (single file) */

// Config
const CONFIG = { canvasW:900, canvasH:560, spawnInterval:2200, botCount:3, invisibleBorderPadding:8, adminCost:10000000 };

// Rarities
const RARITIES = [
  {id:'common', color:'#3ddc84', multiplier:1, name:'Common'},
  {id:'rare',   color:'#2b8af6', multiplier:2, name:'Rare'},
  {id:'legendary', color:'#ffd24a', multiplier:4, name:'Legendary'},
  {id:'mythic', color:'#ff4b4b', multiplier:8, name:'Mythic'},
  {id:'secret', color:'#000000', alt:'#ffffff', multiplier:16, name:'Secret'},
  {id:'BEST', color:'linear-gradient', alt:'#ffb84d', multiplier:64, name:'BEST'}
];

// State
const state = {
  player:{x:120,y:420,w:26,h:26,name:'You',inventory:[],money:0,rebirths:0,level:1},
  bots:[], brainrots:[], bases:[], spawnRate:CONFIG.spawnInterval, adminUnlocked:false, privateMode:false
};

// Canvas
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
canvas.width = CONFIG.canvasW;
canvas.height = CONFIG.canvasH;
function rand(a,b){ return Math.random()*(b-a)+a; }
function dist(x1,y1,x2,y2){ return Math.hypot(x2-x1,y2-y1); }

// Track & black wall
const track = { x:400, y:40, w:360, h:40, colors: ['#ff4b4b','#2b8af6','#3ddc84'] };
const blackWall = {x:400, y:92, w:360, h:24};
const borders = { left:0+CONFIG.invisibleBorderPadding, right:canvas.width-CONFIG.invisibleBorderPadding, top:0+CONFIG.invisibleBorderPadding, bottom:canvas.height-CONFIG.invisibleBorderPadding };

// Bases & bots
function createBase(x,y,name){ return {x,y,w:120,h:80,name,stored:[]}; }
state.bases.push(createBase(40,80,state.player.name));
for(let i=0;i<CONFIG.botCount;i++){ state.bases.push(createBase(600,60 + i*120,'Bot'+(i+1))); }
for(let i=0;i<CONFIG.botCount;i++){ state.bots.push({id:'bot'+i,x:600+rand(0,80),y:120 + i*120,w:24,h:24,name:'Bot'+(i+1),inventory:[],vx:rand(-20,20),vy:rand(-20,20)}); }

// Spawn brainrot
let brID = 1;
function spawnBrainrot(){
  const x = rand(track.x, track.x + track.w);
  const y = blackWall.y + rand(2, blackWall.h-2);
  const roll = Math.random();
  let rarity;
  if(roll < 0.56) rarity = RARITIES[0];
  else if(roll < 0.80) rarity = RARITIES[1];
  else if(roll < 0.92) rarity = RARITIES[2];
  else if(roll < 0.98) rarity = RARITIES[3];
  else if(roll < 0.995) rarity = RARITIES[4];
  else rarity = RARITIES[5];
  const br = {
    id: 'br'+(brID++),
    x, y, vx: rand(-0.3,0.3), vy: rand(-0.2,0.2),
    r: 12 + (rarity.multiplier > 4 ? 6 : 0),
    rarity,
    owner: null,
    dupAnimated: Math.random()*1000
  };
  state.brainrots.push(br);
}

// Drawing & animation
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle = '#07101a';
  ctx.fillRect(0,0,canvas.width,canvas.height);

  const stripeW = track.w / 3;
  ctx.fillStyle = track.colors[0]; ctx.fillRect(track.x, track.y, stripeW, track.h);
  ctx.fillStyle = track.colors[1]; ctx.fillRect(track.x + stripeW, track.y, stripeW, track.h);
  ctx.fillStyle = track.colors[2]; ctx.fillRect(track.x + 2*stripeW, track.y, stripeW, track.h);

  ctx.fillStyle = '#0b0b0b';
  ctx.fillRect(blackWall.x, blackWall.y, blackWall.w, blackWall.h);
  ctx.strokeStyle = '#1a1a1a'; ctx.strokeRect(blackWall.x, blackWall.y, blackWall.w, blackWall.h);

  for(const base of state.bases){
    ctx.fillStyle = '#071a26';
    ctx.fillRect(base.x, base.y, base.w, base.h);
    ctx.strokeStyle = '#ffffff10';
    ctx.strokeRect(base.x, base.y, base.w, base.h);
    ctx.fillStyle = '#fff';
    ctx.font = '12px sans-serif';
    ctx.fillText(base.name, base.x + 6, base.y - 6);
    ctx.fillStyle = '#bfe';
    ctx.fillText('Stored: ' + (base.stored.length), base.x + 6, base.y + base.h + 14);
  }

  for(const br of state.brainrots){
    const bob = Math.sin((Date.now()/300)+br.dupAnimated)*3;
    const drawX = br.x;
    const drawY = br.y + bob;
    if(br.rarity.id === 'secret'){
      ctx.beginPath(); ctx.arc(drawX, drawY, br.r, 0, Math.PI*2);
      ctx.fillStyle = '#000'; ctx.fill();
      ctx.fillStyle = '#fff'; ctx.fillRect(drawX - br.r/2, drawY - 2, br.r, 4);
    } else if(br.rarity.id === 'BEST'){
      ctx.beginPath(); ctx.arc(drawX, drawY, br.r, 0, Math.PI*2);
      const g = ctx.createLinearGradient(drawX-br.r, drawY-br.r, drawX+br.r, drawY+br.r);
      g.addColorStop(0, '#ffb84d'); g.addColorStop(1, '#ff6a00');
      ctx.fillStyle = g; ctx.fill();
    } else {
      ctx.beginPath(); ctx.arc(drawX, drawY, br.r, 0, Math.PI*2);
      ctx.fillStyle = br.rarity.color; ctx.fill();
    }
    ctx.strokeStyle = '#00000055'; ctx.stroke();
    if(br.owner){
      ctx.fillStyle = '#fff'; ctx.font = '11px sans-serif';
      ctx.fillText(br.owner[0].toUpperCase(), drawX - 4, drawY - br.r - 8);
    }
  }

  for(const b of state.bots){
    ctx.fillStyle = '#c1c1c1';
    ctx.beginPath(); ctx.arc(b.x, b.y, 12, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#000'; ctx.font='12px sans-serif'; ctx.fillText(b.name, b.x - 18, b.y - 18);
  }

  ctx.fillStyle = '#90e0ef';
  ctx.beginPath(); ctx.arc(state.player.x, state.player.y, 14, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#000'; ctx.font = '12px sans-serif';
  ctx.fillText(state.player.name, state.player.x - 18, state.player.y - 20);
}

// Movement & physics
const keys = {};
window.addEventListener('keydown', e=>{ keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', e=>{ keys[e.key.toLowerCase()] = false; });

function clampToBorders(obj){
  if(obj.x < borders.left) obj.x = borders.left;
  if(obj.x > borders.right) obj.x = borders.right;
  if(obj.y < borders.top) obj.y = borders.top;
  if(obj.y > borders.bottom) obj.y = borders.bottom;
}

// simple AI for bots
function updateBots(dt){
  for(const b of state.bots){
    const baseIndex = state.bots.indexOf(b) + 1;
    const base = state.bases[baseIndex];
    if(b.inventory && b.inventory.length > 0){
      const tx = base.x + base.w / 2, ty = base.y + base.h / 2;
      moveTowards(b, tx, ty, 40 * dt);
      if(dist(b.x,b.y,tx,ty) < 18){
        for(const br of b.inventory){ base.stored.push(br); br.owner = b.name; }
        b.inventory = [];
      }
    } else {
      const target = findNearestBrainrot(b.x, b.y, 300);
      if(target){
        moveTowards(b, target.x, target.y, 60 * dt);
        if(dist(b.x,b.y,target.x,target.y) < target.r + 8){
          b.inventory = b.inventory || [];
          b.inventory.push(target);
          const idx = state.brainrots.indexOf(target);
          if(idx!==-1) state.brainrots.splice(idx,1);
        }
      } else {
        b.vx = b.vx || rand(-20,20);
        b.vy = b.vy || rand(-20,20);
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        if(Math.random() < 0.01){ b.vx = rand(-20,20); b.vy = rand(-20,20); }
      }
    }
    clampToBorders(b);
  }
}

// Player actions
function updatePlayer(dt){
  const speed = 160;
  if(keys['w'] || keys['arrowup']) state.player.y -= speed * dt;
  if(keys['s'] || keys['arrowdown']) state.player.y += speed * dt;
  if(keys['a'] || keys['arrowleft']) state.player.x -= speed * dt;
  if(keys['d'] || keys['arrowright']) state.player.x += speed * dt;
  clampToBorders(state.player);
}

function tryPickupNearest(){
  const pr = state.player;
  const r = 26 + 14;
  let nearest = null; let nd = 1e9;
  for(const br of state.brainrots){
    const d = dist(pr.x,pr.y,br.x,br.y);
    if(d < r + br.r && d < nd){
      nd = d; nearest = br;
    }
  }
  if(nearest){
    pr.inventory.push(nearest);
    const idx = state.brainrots.indexOf(nearest);
    if(idx!==-1) state.brainrots.splice(idx,1);
    showTempPopup('Picked up ' + nearest.rarity.name);
    updateInventoryUI();
  }
}

function tryDeliverToBase(){
  const base = state.bases[0]; // player's base
  const bx = base.x + base.w/2, by = base.y + base.h/2;
  if(dist(state.player.x, state.player.y, bx, by) < 48){
    for(const br of state.player.inventory){
      base.stored.push(br);
      br.owner = state.player.name;
      const baseValue = 10 * br.rarity.multiplier;
      const rebBonus = 1 + state.player.rebirths * 0.05;
      const gained = Math.floor(baseValue * rebBonus);
      state.player.money += gained;
    }
    state.player.inventory = [];
    showTempPopup('Delivered! + Robo');
    updateMoneyUI();
    updateInventoryUI();
  } else {
    showTempPopup('Move to your base to deliver!');
  }
}

function checkSteals(){
  for(const b of state.bots){
    if(b.inventory && b.inventory.length > 0){
      const d = dist(b.x,b.y,state.player.x,state.player.y);
      if(d < 30){
        if(Math.random() < 0.5){
          const stolen = b.inventory.pop();
          state.player.inventory.push(stolen);
          showTempPopup('Stole ' + stolen.rarity.name + ' from ' + b.name);
          updateInventoryUI();
        } else {
          b.x += rand(-40,40); b.y += rand(-40,40);
          showTempPopup('Attempt failed!');
        }
      }
    }
  }
}

// Utilities
function findNearestBrainrot(x,y,maxDist){
  let best = null, bd = maxDist;
  for(const br of state.brainrots){
    const d = dist(x,y,br.x,br.y);
    if(d < bd){ bd = d; best = br; }
  }
  return best;
}
function moveTowards(obj, tx, ty, speed){
  const dx = tx - obj.x, dy = ty - obj.y;
  const d = Math.hypot(dx,dy); if(d < 1) return;
  obj.x += (dx/d) * speed;
  obj.y += (dy/d) * speed;
}

// UI / HUD
function updateInventoryUI(){ document.getElementById('invCount').innerText = state.player.inventory.length; }
function updateMoneyUI(){ document.getElementById('moneyDisplay').innerText = 'Robo: ' + state.player.money; document.getElementById('rebirthCount').innerText = 'Rebirths: ' + state.player.rebirths; }
function showTempPopup(text, duration=1800){
  const p = document.createElement('div'); p.className='popup'; p.innerText = text;
  document.body.appendChild(p);
  setTimeout(()=> p.remove(),duration);
}

// Input bindings
canvas.addEventListener('click', (e)=>{
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  let nearest=null, nd=9999;
  for(const br of state.brainrots){
    const d = dist(mx,my,br.x,br.y); if(d < 40 && d < nd){ nd = d; nearest=br; }
  }
  if(nearest){
    state.player.inventory.push(nearest);
    const idx = state.brainrots.indexOf(nearest); if(idx!==-1) state.brainrots.splice(idx,1);
    showTempPopup('Picked up ' + nearest.rarity.name);
    updateInventoryUI();
    return;
  }
});

window.addEventListener('keydown', (e)=>{
  if(e.key.toLowerCase() === 'e'){ tryDeliverToBase(); }
  if(e.key.toLowerCase() === 'f'){ tryPickupNearest(); }
});

// Shop
const shopItems = [
  {id:'money_pack', name:'Small Robo Pack', price:200, effect: (pl)=> pl.money += 200},
  {id:'better_bag', name:'Better Bag (+inv cap)', price:2000, effect: (pl)=> {/* future */}},
  {id:'auto_collector', name:'Auto Collector (10s)', price:12000, effect: (pl)=>{/* future*/}}
];
function renderShop(){
  const cont = document.getElementById('shop-items'); cont.innerHTML='';
  for(const it of shopItems){
    const div = document.createElement('div'); div.style.display='flex'; div.style.justifyContent='space-between'; div.style.alignItems='center';
    div.style.padding='6px'; div.style.background='#00000022'; div.style.borderRadius='6px';
    div.innerHTML = `<div><strong>${it.name}</strong><div class="small">Price: ${it.price} Robo</div></div><div><button class="btn">Buy</button></div>`;
    const btn = div.querySelector('button');
    btn.onclick = ()=> {
      if(state.player.money >= it.price){
        state.player.money -= it.price;
        it.effect(state.player);
        saveState();
        updateMoneyUI();
        showTempPopup('Purchased ' + it.name);
      } else {
        showTempPopup('Not enough Robo');
      }
    };
    cont.appendChild(div);
  }
}

// Rebirth
document.getElementById('rebirthBtn').addEventListener('click', ()=>{
  const cost = 1_000_000;
  if(state.player.money >= cost){
    state.player.money = 0;
    state.player.rebirths += 1;
    state.spawnRate = Math.max(600, state.spawnRate - 80);
    showTempPopup('Rebirthed! multiplier increased');
    saveState();
    updateMoneyUI();
  } else {
    showTempPopup('Need ' + cost + ' Robo to rebirth');
  }
});

// Admin purchase
document.getElementById('buyAdminBtn').addEventListener('click', ()=>{
  if(state.adminUnlocked){ showTempPopup('Admin already unlocked'); return; }
  if(state.player.money >= CONFIG.adminCost){
    state.player.money -= CONFIG.adminCost;
    state.adminUnlocked = true;
    document.getElementById('adminPanel').style.display = 'block';
    saveState();
    updateMoneyUI();
    showTempPopup('Admin Panel purchased');
  } else showTempPopup('Need ' + CONFIG.adminCost + ' Robo for Admin');
});
document.getElementById('adminSpawnFaster').addEventListener('click', ()=> { state.spawnRate = Math.max(300, state.spawnRate - 200); showTempPopup('Spawn faster'); });
document.getElementById('adminSpawnSlower').addEventListener('click', ()=> { state.spawnRate += 200; showTempPopup('Spawn slower'); });

// Private server UI (UI-only for prototype)
document.getElementById('makePrivateBtn').addEventListener('click', ()=>{
  state.privateMode = !state.privateMode;
  document.getElementById('psMode').innerText = state.privateMode ? 'Private' : 'Public';
  showTempPopup('Server mode: ' + (state.privateMode ? 'Private' : 'Public') );
});

// Intro & start
document.getElementById('startBtn').addEventListener('click', ()=> {
  document.getElementById('introOverlay').style.display = 'none';
  startGame();
});
document.getElementById('tutorialBtn').addEventListener('click', ()=> {
  alert('Move with WASD or arrows. Click or press F to pick up nearby Brainrots. Press E to deliver to your base. Steal from bots by touching them while they carry Brainrots.');
});

// Spawn loop & main update
function spawnTick(){
  spawnBrainrot();
  scheduleNextSpawn();
}
function scheduleNextSpawn(){
  clearTimeout(state._spawnTimeout);
  state._spawnTimeout = setTimeout(spawnTick, state.spawnRate);
}

let lastFrame = performance.now();
function frame(){
  const now = performance.now();
  const dt = Math.min(0.05,(now-lastFrame)/1000);
  lastFrame = now;

  for(const br of state.brainrots){
    br.x += br.vx * dt * 40;
    br.y += br.vy * dt * 40;
    if(br.x < borders.left + 10 || br.x > borders.right - 10) br.vx *= -1;
    if(br.y < borders.top + 10 || br.y > borders.bottom - 10) br.vy *= -1;
  }

  updatePlayer(dt);
  updateBots(dt);
  checkSteals();

  draw();
  requestAnimationFrame(frame);
}

function startGame(){
  state.player.inventory = state.player.inventory || [];
  loadState();
  updateMoneyUI();
  updateInventoryUI();
  renderShop();
  scheduleNextSpawn();
  requestAnimationFrame(frame);
}

// Save / load
function saveState(){ localStorage.setItem('takeabr_save', JSON.stringify({player:state.player, spawnRate: state.spawnRate, adminUnlocked: state.adminUnlocked})); }
function loadState(){ const s = localStorage.getItem('takeabr_save'); if(s){ const p=JSON.parse(s); state.player = Object.assign(state.player, p.player); state.spawnRate = p.spawnRate || state.spawnRate; state.adminUnlocked = p.adminUnlocked || false; if(state.adminUnlocked) document.getElementById('adminPanel').style.display='block'; } }

// Initial seed: spawn a few brainrots to start
for(let i=0;i<6;i++) spawnBrainrot();
loadState();
renderShop();
updateMoneyUI();
updateInventoryUI();

// quick keys
document.addEventListener('keydown', e=> {
  if(e.key === '1'){ tryPickupNearest(); }
  if(e.key === '2'){ tryDeliverToBase(); }
});

// autosave
setInterval(()=> saveState(), 5000);

</script>
</body>
</html>
